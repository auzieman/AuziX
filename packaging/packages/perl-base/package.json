{
  "format": "auzix-package-v1",
  "name": "PerlBase",
  "version": "trixie",
  "source": {
    "kind": "existing-auzix-payload",
    "receipt_glob": "System/PackageDB/PerlBase-*.auzix.json"
  },
  "layout": {
    "domain": "program",
    "prefix": "/Programs/PerlBase/${version}"
  },
  "dependencies": {
    "runtime": ["RuntimeGlibc", "Libcrypt1"]
  },
  "intake_adapter": {
    "format": "auzix-lifecycle-adapter-v1",
    "template_dir": "packaging/packages/perl-base/lifecycle",
    "configuration": [],
    "scripts": {},
    "compatibility_links": [
      {
        "path": "/System/Compatibility/usr/lib/x86_64-linux-gnu/perl-base",
        "target": "@PACKAGE_ROOT@/RootFS/usr/lib/x86_64-linux-gnu/perl-base"
      }
    ],
    "operations": [
      {
        "type": "publish-language-runtime",
        "runtime": "perl-base",
        "disposition": "canonical-compatibility-search-path"
      }
    ]
  },
  "lifecycle": {
    "before_install": null,
    "after_install": null,
    "before_remove": null,
    "after_remove": null
  },
  "validation": {
    "commands": ["perl --version"]
  }
}
