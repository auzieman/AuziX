{
  "format": "auzix-package-v1",
  "name": "Acpid",
  "version": "trixie",
  "source": {"kind": "existing-auzix-payload", "receipt_glob": "System/PackageDB/Acpid-*.auzix.json"},
  "layout": {"domain": "program", "prefix": "/Programs/Acpid/${version}"},
  "dependencies": {"runtime": ["RuntimeGlibc", "Kmod"]},
  "intake_adapter": {
    "format": "auzix-lifecycle-adapter-v1",
    "template_dir": "packaging/packages/acpid/lifecycle",
    "configuration": [],
    "scripts": {},
    "operations": [{
      "type": "discard-donor-maintainer-protocol",
      "disposition": "replaced-by-package-owned-runtime-and-auzix-service-startup"
    }]
  },
  "lifecycle": {"before_install": null, "after_install": null, "before_remove": null, "after_remove": null},
  "validation": {"commands": ["acpid --help"]}
}
