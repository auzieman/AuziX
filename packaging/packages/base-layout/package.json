{
  "format": "auzix-package-v1",
  "name": "BaseLayout",
  "version": "1.0.0",
  "source": {
    "kind": "generated-layout",
    "directories": [
      "/Libraries/Packages",
      "/Libraries/Private",
      "/Libraries/Runtime",
      "/Programs",
      "/Services",
      "/System/Boot",
      "/System/Compatibility/bin",
      "/System/Compatibility/lib",
      "/System/Compatibility/lib64",
      "/System/Compatibility/sbin",
      "/System/Compatibility/usr",
      "/System/Libraries",
      "/System/Logs",
      "/System/PackageDB",
      "/System/Run",
      "/System/Settings",
      "/System/State",
      "/Users/root",
      "/Work/Temp"
    ],
    "links": {}
  },
  "layout": {"domain": "system-runtime", "prefix": "/System"},
  "payload": {"surfaces": ["/Programs", "/Services", "/System", "/Users", "/Work"]},
  "dependencies": {"runtime": [], "provides": ["auzix-root-layout"]},
  "fragments": ["layout.canonical-directories"],
  "validation": {"commands": ["test -d /System/Settings"]}
}
