{
  "format": "auzix-package-v1",
  "name": "Python3",
  "version": "trixie",
  "source": {
    "kind": "existing-auzix-payload",
    "receipt_glob": "System/PackageDB/Python3-*.auzix.json"
  },
  "layout": {
    "domain": "program",
    "prefix": "/Programs/Python3/${version}"
  },
  "dependencies": {
    "runtime": ["Python3Minimal", "Python313Minimal", "Libpython313Stdlib"]
  },
  "intake_adapter": {
    "format": "auzix-lifecycle-adapter-v1",
    "template_dir": "packaging/packages/python3/lifecycle",
    "configuration": [],
    "scripts": {},
    "operations": [
      {
        "type": "discard-donor-maintainer-protocol",
        "disposition": "replaced-by-auzix-python-front-doors-and-package-owned-runtime"
      }
    ]
  },
  "lifecycle": {
    "before_install": null,
    "after_install": null,
    "before_remove": null,
    "after_remove": null
  },
  "validation": {
    "commands": ["python3 --version"]
  }
}
