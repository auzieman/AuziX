#!/bin/sh
set -eu

settings=${AUZIX_SETTINGS:-/System/Settings}
state=${AUZIX_STATE:-/System/State}
run=${AUZIX_RUN:-/System/Run}

touch "$settings/passwd" "$settings/group" "$settings/shadow"
grep -q '^glances:' "$settings/group" || printf '%s\n' 'glances:x:76:' >>"$settings/group"
grep -q '^glances:' "$settings/passwd" || printf '%s\n' 'glances:x:76:76:Glances service:/System/State/glances:/sbin/nologin' >>"$settings/passwd"
grep -q '^glances:' "$settings/shadow" || printf '%s\n' 'glances:!:0:0:99999:7:::' >>"$settings/shadow"
chmod 0644 "$settings/passwd" "$settings/group"
chmod 0600 "$settings/shadow"

mkdir -p "$state/glances" "$run/glances" /Services/glances
chown 76:76 "$state/glances" "$run/glances"
chmod 0750 "$state/glances"
chmod 0755 "$run/glances"

cat >/Services/glances/run <<'EOF'
#!/System/Compatibility/bin/sh
set -eu
exec /Programs/BusyBox/current/Commands/busybox setuidgid glances \
  @PACKAGE_ROOT@/Commands/glances -C /System/Settings/glances/glances.conf -s -B 127.0.0.1
EOF
chmod 0755 /Services/glances/run
