{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auzix.local/schemas/activation-fragment-v1.schema.json",
  "title": "AUZiX activation fragment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "owner", "source_logic", "creates", "policy", "gates"],
  "properties": {
    "format": {"const": "auzix-activation-fragment-v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]+$"},
    "owner": {"type": "string", "minLength": 1},
    "source_logic": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "creates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "policy": {"type": "object"},
    "gates": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  }
}
