create_sshdconfig() {
	# XXX cjwatson 2016-12-24: This debconf template is very confusingly
	# named; its description is "Disable SSH password authentication for
	# root?", so true -> prohibit-password (the upstream default),
	# false -> yes.
	: # stripped donor debconf

	permit_root_login="$RET"
	: # stripped donor debconf

	password_authentication="$RET"

	trap cleanup EXIT
	new_config="$(mktemp)"
	cp -aZ ${AUZIX_PACKAGE_ROOT}/RootFS/usr/share/openssh/sshd_config "$new_config"
	if [ "$permit_root_login" != true ]; then
		sed -i 's/^#*PermitRootLogin .*/PermitRootLogin yes/' \
			"$new_config"
	fi
	if [ "$password_authentication" != true ]; then
		sed -i 's/^#PasswordAuthentication .*/PasswordAuthentication no/' \
			"$new_config"
	fi
	mkdir -pZ ${AUZIX_SETTINGS}/ssh
	ucf --three-way --debconf-ok \
		--sum-file ${AUZIX_PACKAGE_ROOT}/RootFS/usr/share/openssh/sshd_config.md5sum \
		"$new_config" ${AUZIX_SETTINGS}/ssh/sshd_config
	ucfr openssh-server ${AUZIX_SETTINGS}/ssh/sshd_config
}

