{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auzix.dev/schemas/install-plan-v1.json",
  "title": "AuziX install plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "target",
    "storage",
    "bootloader",
    "identity",
    "execution"
  ],
  "properties": {
    "format": {
      "const": "auzix-install-plan-v1"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disk"],
      "properties": {
        "disk": {
          "type": "string",
          "pattern": "^/dev/([A-Za-z0-9._:+-]+|disk/by-id/[A-Za-z0-9._:+-]+)$"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filesystem"],
      "properties": {
        "filesystem": {
          "enum": ["ext4"]
        },
        "layout": {
          "enum": ["whole", "split"]
        },
        "home_percent": {
          "type": "integer",
          "minimum": 20,
          "maximum": 80
        }
      }
    },
    "bootloader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["grub", "iso"]
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname"],
      "properties": {
        "hostname": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,62}$"
        },
        "username": {"type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,31}$"},
        "locale": {"type": "string"},
        "timezone": {"type": "string"},
        "keyboard": {"type": "string"}
      }
    },
    "accounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_policy"],
      "properties": {"root_policy": {"enum": ["disabled", "same", "separate"]}}
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected"],
      "properties": {
        "selected": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9._+-]+$"}, "uniqueItems": true}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed"],
      "properties": {
        "confirmed": {
          "type": "boolean"
        }
      }
    },
    "frontend": {
      "enum": ["default", "tui", "graphical", "automation"]
    }
  }
}
