{
  "format": "auzix-command-suite-v1",
  "name": "Nginx",
  "version": "auto",
  "description": "Small HTTP service used to prove the first AUZiX-managed container service.",
  "source": {
    "type": "debian-binary",
    "suite": "trixie",
    "package": "nginx-light",
    "graduation": "upstream-source"
  },
  "commands": [
    {"name": "nginx", "host_command": "nginx"}
  ],
  "validation": {
    "smoke_commands": [
      "/Libraries/ld-linux-x86-64.so.2 --library-path /Libraries:/Programs/Nginx/current/Libraries /Programs/Nginx/current/Commands/nginx.real -v 2>&1 | /Programs/BusyBox/current/Commands/busybox grep -F nginx/"
    ]
  }
}
