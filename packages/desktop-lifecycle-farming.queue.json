        "polkitd",
        "pkexec",
        "libpolkit-agent-1-0",
        "libpolkit-gobject-1-0"
      ],
      "status": "captured",
      "why": "GUI admin operations, Flatpak system helper, disks, network, users and control panels need Polkit policy and agent semantics.",
      "receipts": [
        "out/pipeline-receipts/desktop-lifecycle-farming/desktop-lifecycle-farming-20260814T021033Z.json"
      ]
    },
    {
      "id": "desktop-enlightenment-session",
